APP_NAME=FileShareBox PHP
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Shanghai
APP_DEBUG=0

DB_HOST=db
DB_PORT=3306
DB_DATABASE=filesharebox
DB_USERNAME=root
DB_PASSWORD=root
DB_CHARSET=utf8mb4

UPLOAD_DIR=
MAX_UPLOAD_MB=200
MAX_TEXT_LENGTH=20000

UPLOAD_WINDOW_SECONDS=300
UPLOAD_MAX_HITS=10
UPLOAD_BLOCK_MINUTES=10

FETCH_FAIL_WINDOW_SECONDS=300
FETCH_FAIL_MAX_HITS=8
FETCH_FAIL_BLOCK_MINUTES=10

CODE_MIN_LEN=4
CODE_MAX_LEN=32
DEFAULT_CODE_LEN=6
SESSION_TTL=7200
ALLOW_GUEST_UPLOAD=1
